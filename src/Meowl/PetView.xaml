<UserControl x:Class="Meowl.PetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="160" Height="180">
    <!--
        Pixel-Art-Katzeneule: 32 x 36 Pixel, jeder Pixel wird 5 x 5 groß
        und ohne Glättung gezeichnet. Der Boden (Füße) liegt ganz unten.
    -->
    <Image x:Name="Sprite" Width="160" Height="180" Stretch="Fill"
           RenderOptions.BitmapScalingMode="NearestNeighbor"
           RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
            <!-- Blickrichtung (links/rechts) -->
            <ScaleTransform x:Name="FacingTransform" />
        </Image.RenderTransform>
    </Image>
</UserControl>
