<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms nur für das Tray-Icon (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Meowl</AssemblyName>
    <RootNamespace>Meowl</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\pet.ico')">Assets\pet.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF und WinForms haben gleichnamige Typen (Application, Point, ...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.60.0" />
  </ItemGroup>

</Project>
