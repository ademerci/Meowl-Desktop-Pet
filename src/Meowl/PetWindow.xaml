<Window x:Class="Meowl.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Meowl"
        Title="Meowl"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid x:Name="RootGrid" Width="260" Height="302">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="122" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>
        <!-- Rechtsklick auf Meowl (durchsichtige Stellen sind durchklickbar) -->
        <Grid.ContextMenu>
            <ContextMenu x:Name="PetMenu" Opened="PetMenu_Opened">
                <MenuItem Header="💬  Chatten" Click="MenuChat_Click" FontWeight="SemiBold" />
                <MenuItem Header="🤍  Streicheln" Click="MenuPet_Click" />
                <MenuItem Header="🕊  Fliegen" Click="MenuFly_Click" />
                <MenuItem Header="💃  Tanzen" Click="MenuDance_Click" />
                <MenuItem x:Name="MenuSleep" Header="💤  Schlafen" Click="MenuSleep_Click" />
                <MenuItem x:Name="MenuStay" Header="📌  Hierbleiben" IsCheckable="True" Click="MenuStay_Click" />
                <Separator />
                <MenuItem Header="📝  Notizen öffnen" Click="MenuNotes_Click" />
                <MenuItem Header="⚙  Einstellungen" Click="MenuSettings_Click" />
                <Separator />
                <MenuItem Header="👋  Beenden" Click="MenuExit_Click" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Kleine Sprechblase über dem Kopf -->
        <StackPanel x:Name="Bubble" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="8,0,8,4" Visibility="Collapsed" Cursor="Hand"
                    MouseLeftButtonUp="Bubble_MouseLeftButtonUp">
            <StackPanel.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" CenterY="110" ScaleX="1" ScaleY="1" />
            </StackPanel.RenderTransform>
            <Border Background="#FFFDF8" BorderBrush="#E6D3BC" BorderThickness="1.5" CornerRadius="14"
                    Padding="11,7" MaxWidth="244">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.25" />
                </Border.Effect>
                <TextBlock x:Name="BubbleText" TextWrapping="Wrap" FontSize="13" Foreground="#3B2A1E"
                           TextTrimming="CharacterEllipsis" MaxHeight="92" />
            </Border>
            <Path Data="M 0,0 L 7,9 L 14,0" Fill="#FFFDF8" Stroke="#E6D3BC" StrokeThickness="1.5"
                  HorizontalAlignment="Center" Margin="0,-1.5,0,0" />
        </StackPanel>

        <!-- Das Haustier -->
        <local:PetView x:Name="Pet" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Cursor="Hand" Background="Transparent"
                       MouseLeftButtonDown="Pet_MouseLeftButtonDown"
                       MouseLeftButtonUp="Pet_MouseLeftButtonUp"
                       MouseMove="Pet_MouseMove"
                       MouseEnter="Pet_MouseEnter">
            <local:PetView.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.3" />
            </local:PetView.Effect>
        </local:PetView>

        <!-- Effekte (Herzen, Zzz, Noten) -->
        <Canvas x:Name="FxLayer" Grid.RowSpan="2" IsHitTestVisible="False" />
    </Grid>
</Window>
